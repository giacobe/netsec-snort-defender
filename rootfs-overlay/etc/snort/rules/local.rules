# Snort Local Rules
# Format: alert <proto> <src_ip> <src_port> -> <dst_ip> <dst_port> (msg:"..."; sid:...; rev:1;)
#
# Example:
# alert tcp any any -> any 80 (msg:"WEB traffic"; sid:1000001; rev:1;)
